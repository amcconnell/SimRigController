[Unit]
Description=Set audio output mixer levels for the sim rig
# Must land before the shaker opens the device, or the first session of every
# boot runs at whatever level the adapter happened to enumerate with.
After=sound.target
Before={{ simrig_service_name }}.service
Wants=sound.target

[Service]
Type=oneshot
# Deliberately NOT RemainAfterExit. Leaving the unit "active (exited)" means a
# later Wants= from udev is a no-op, so hot-plugging a card would queue a run
# that never happens. Ordering before the shaker at boot does not depend on it:
# a oneshot counts as still starting until ExecStart returns.
ExecStart={{ simrig_app_root }}/bin/alsa-levels.sh

[Install]
WantedBy=multi-user.target
