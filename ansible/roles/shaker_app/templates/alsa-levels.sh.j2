#!/bin/sh
# Set output mixer levels at boot. Managed by Ansible — edit the role, not this.
#
# USB audio adapters routinely enumerate with their output attenuated; the
# C-Media dongle on this rig comes up at -20 dB, which is quieter than the Pi's
# own headphone jack and looks exactly like "the DAC made no difference". The
# software cannot see it: every level the app reports is the buffer it computed,
# upstream of the DAC entirely.
#
# The source belongs at unity so the full converter range is used and level is
# set downstream at the amplifier.
#
# Cards are matched by name rather than index — index depends on enumeration
# order and changes when anything else is plugged in.

set -u

# Retried, because this also runs from a udev hot-plug where the card node
# exists before its control device does. At boot the first attempt succeeds and
# the loop costs nothing.
_ATTEMPTS=12
_DELAY=0.25

# Set when a card is actually configured, so the rebind at the end only fires
# for a card this rig cares about rather than any USB audio device plugged in.
_matched=0

{% for c in simrig_alsa_levels %}
n=0
while [ "$n" -lt "$_ATTEMPTS" ]; do
    n=$((n + 1))
    card="$(cat /proc/asound/cards 2>/dev/null \
            | grep -i -- '{{ c.card_match }}' \
            | head -1 | awk '{print $1}')"
    if [ -n "${card:-}" ] \
       && amixer -c "$card" sset '{{ c.control }}' '{{ c.value }}' >/dev/null 2>&1; then
        echo "set card $card '{{ c.control }}' to {{ c.value }} (matched '{{ c.card_match }}')"
        _matched=1
        break
    fi
    if [ "$n" -ge "$_ATTEMPTS" ]; then
        if [ -n "${card:-}" ]; then
            echo "card $card never accepted control '{{ c.control }}' — skipping" >&2
        else
            echo "no card matching '{{ c.card_match }}' — skipping" >&2
        fi
        break
    fi
    sleep "$_DELAY"
done
{% endfor %}

# Rebind the app to a card that appeared after it started.
#
# The audio stream is opened once, at startup. A DAC that enumerates even a
# second late leaves the app bound to whatever else it found — on this rig the
# Pi's own headphone jack — and it stays there. It logs the fallback and then
# behaves perfectly normally, so the rig reports healthy, the meters move, and
# nothing reaches the amplifier. That cost a day: the DAC enumerated twelve
# minutes after boot during some hardware work, and the fault presented as
# "the controller isn't running".
#
# Guarded on the app already running, for two reasons. At boot this script is
# ordered Before= the app, so there is nothing to restart and a restart would
# only undo the ordering that exists to get levels set first. And a restart
# queued at boot would land just after the app started, making every boot look
# like a crash loop.
#
# --no-block is not optional. This unit is ordered before the app, so a
# blocking restart would have systemd waiting on a job that waits on this
# script: a textbook deadlock, and one that only shows up on the hot-plug path
# where it is hardest to notice.
#
# Restarting is heavier than reopening the device would be — it drops the GT7
# session for a second or two and ends any recording in progress. Worth it:
# the alternative is silence that looks like health.
if [ "$_matched" -eq 1 ] \
   && systemctl is-active --quiet {{ simrig_service_name }}.service; then
    echo "sound card appeared while {{ simrig_service_name }} was running — rebinding"
    systemctl --no-block try-restart {{ simrig_service_name }}.service || true
fi

exit 0
